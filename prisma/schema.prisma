generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // sem url no Prisma v7
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users     User[]
  campaigns Campaign[]
  licenses  License[]
}

model User {
  id        String   @id @default(cuid())
  email     String
  password  String
  role      Role     @default(VIEWER)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())

  @@unique([tenantId, email])
}

model License {
  id         String   @id @default(uuid())
  tenantId   String
  plan       Plan
  expiresAt  DateTime
  maxDevices Int      @default(1)
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model Campaign {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  slug      String
  channel   String // QR, Link, Tablet
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  responses Response[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Response {
  id         String   @id @default(uuid())
  campaignId String
  score      Int
  comment    String?
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
}

enum Role {
  ADMIN
  MANAGER
  VIEWER
}

enum Plan {
  FREE
  MONTHLY
  YEARLY
}
